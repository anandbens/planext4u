{
  "rewrites": [
    {
      "source": "/media-library/:path*",
      "destination": "https://cdn.planext4u.net/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/media-library/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
